    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-storybook": "^10.3.4",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "playwright": "^1.59.1",
    "prettier": "3.8.1",
    "storybook": "^10.3.4",
    "tailwindcss": "^4.2.2",
